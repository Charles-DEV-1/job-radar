SUPABASE_URL=
SUPABASE_SERVICE_KEY=
# openai, anthropic, or groq; Groq uses its fixed OpenAI-compatible Chat API.
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=
# Match your account's supported TPM quota; e.g. 8000 for a confirmed 8K limit.
LLM_MAX_TOKENS_PER_MINUTE=6000
# Optional, explicit model prices; cost_usd is null when prices/usage are unknown.
LLM_INPUT_USD_PER_MILLION=
LLM_OUTPUT_USD_PER_MILLION=
# Optional existing Chromium executable; otherwise install Playwright Chromium.
PLAYWRIGHT_CHROMIUM_EXECUTABLE=
RESUME_MAX_PER_RUN=3
# Optional existing LibreOffice executable for PDF/pagination checks.
LIBREOFFICE_EXECUTABLE=
RESEND_API_KEY=
NOTIFY_EMAIL=
DASHBOARD_URL=
