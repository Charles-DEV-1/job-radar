SUPABASE_URL=
SUPABASE_SERVICE_KEY=
# openai, anthropic, groq, or google (Gemini API via Google AI Studio).
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=
# Set to local to tailor resumes without sending their contents to the LLM.
RESUME_TAILORING_MODE=llm
# Match your account's supported TPM quota; e.g. 8000 for a confirmed 8K limit.
LLM_MAX_TOKENS_PER_MINUTE=6000
# Hard caps shared across careers-page extraction and resume tailoring in one run.
LLM_MAX_CALLS_PER_RUN=50
CAREERS_MAX_FETCHES_PER_RUN=20
# Optional, explicit model prices; cost_usd is null when prices/usage are unknown.
LLM_INPUT_USD_PER_MILLION=
LLM_OUTPUT_USD_PER_MILLION=
# Optional existing Chromium executable; otherwise install Playwright Chromium.
PLAYWRIGHT_CHROMIUM_EXECUTABLE=
RESUME_MAX_PER_RUN=3
# Set to radar-resumes only when run_all should stage private master inputs from Storage.
RESUME_INPUTS_BUCKET=
# Optional existing LibreOffice executable for PDF/pagination checks.
LIBREOFFICE_EXECUTABLE=
RESEND_API_KEY=
# Sender must be a verified sender/domain in your Resend account.
RESEND_FROM_EMAIL=
NOTIFY_EMAIL=
DASHBOARD_URL=
# Wait this long for tailoring before notifying; ready/failed resumes notify immediately.
NOTIFY_RESUME_GRACE_MINUTES=30
# Stage 5 uses dashboard/.env.local; see dashboard/.env.example and dashboard/README.md.
